# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno de la app (adhouse-reporting)
#
# Local:  copiar a `.env.local` y completar.
# Dokploy: Application → Environment. Las NEXT_PUBLIC_* van ADEMÁS en
#          Build Args (se incrustan en el bundle durante `next build`).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (obligatorias) ──────────────────────────────────────────────────
# URL y anon key son públicas (viajan al navegador). La service role NO:
# se salta las RLS y solo se lee en el servidor.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── App (obligatoria) ────────────────────────────────────────────────────────
# Dominio público real. La usan los enlaces de reportes, los callbacks OAuth y
# el sync manual del dashboard, que llama a sus propios endpoints por HTTP.
# Sin barra final.
NEXT_PUBLIC_APP_URL=https://reportes.adshouse.cloud

# ── Cron / worker (obligatoria) ──────────────────────────────────────────────
# Bearer token que exigen todos los endpoints /api/cron/* y /api/worker/*.
# Debe coincidir EXACTAMENTE con el del sync-worker y el secret de GitHub.
#   openssl rand -hex 32
CRON_SECRET=

# ── Cifrado de secretos de report-utm ────────────────────────────────────────
# 64 caracteres hex = 32 bytes. Cambiarla deja ilegibles los tokens ya
# guardados en la base de datos.
#   openssl rand -hex 32
RUTM_ENCRYPTION_KEY=

# ── Administración / correo ──────────────────────────────────────────────────
ADMIN_EMAIL=
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=

# ── Meta (Facebook/Instagram Ads) ────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=

# ── TikTok Ads ───────────────────────────────────────────────────────────────
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# ── Google Sheets / GA4 (service account) ────────────────────────────────────
# GOOGLE_SERVICE_ACCOUNT_KEY es la clave privada PEM COMPLETA, con los saltos
# de línea escapados como \n dentro de comillas dobles.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Google Ads (OAuth) ───────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v21

# ── Hotmart ──────────────────────────────────────────────────────────────────
HOTMART_APP_CLIENT_ID=
HOTMART_APP_CLIENT_SECRET=

# ── WhatsApp ─────────────────────────────────────────────────────────────────
# `evolution` usa Evolution API; `gateway` usa el proceso whatsapp-gateway/.
WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_API_KEY=

# ── Opcionales ───────────────────────────────────────────────────────────────
# Activa el módulo report-utm en la interfaz.
NEXT_PUBLIC_REPORT_UTM_ENABLED=false
# Presupuesto en ms para los sincronizadores de leads (por defecto ~50 s).
META_LEADS_BUDGET_MS=
GHL_LEADS_BUDGET_MS=
# Solo para el CLI de Supabase en local; el runtime no lo usa.
SUPABASE_ACCESS_TOKEN=
