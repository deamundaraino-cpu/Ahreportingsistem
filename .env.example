# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno de la app (adhouse-reporting)
#
# Local:  copiar a `.env.local` y completar.
# Dokploy: Application → Environment. Las NEXT_PUBLIC_* van ADEMÁS en
#          Build Args (se incrustan en el bundle durante `next build`).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (obligatorias) ──────────────────────────────────────────────────
# URL y anon key son públicas (viajan al navegador). La service role NO:
# se salta las RLS y solo se lee en el servidor.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── App (obligatoria) ────────────────────────────────────────────────────────
# Dominio público real. La usan los enlaces de reportes, los callbacks OAuth y
# el sync manual del dashboard, que llama a sus propios endpoints por HTTP.
# Sin barra final.
NEXT_PUBLIC_APP_URL=https://reportes.adshouse.cloud

# ── Cron / worker (obligatoria) ──────────────────────────────────────────────
# Bearer token que exigen todos los endpoints /api/cron/* y /api/worker/*.
# Debe coincidir EXACTAMENTE con el del sync-worker y el secret de GitHub.
#   openssl rand -hex 32
CRON_SECRET=

# ── Presupuestos del ejecutor de respaldo (/api/worker/run-jobs) ─────────────
# Opcionales: los defaults del código ya son los correctos para un contenedor.
# Sólo hay que tocarlos si el proxy de delante corta las peticiones largas.
#
# No los bajes sin motivo: con 50 s el drenador abortaba jobs sanos por falta
# de presupuesto PROPIO y a los 3 abortos los pintaba de rojo (era el error más
# frecuente del sistema). En Docker no hay límite de plataforma.
#
# El lease debe superar siempre al budget: si vence mientras el job aún corre,
# otro ejecutor lo reclama en paralelo y ambos se pisan los datos del cliente.
# RUNJOBS_BUDGET_MS=240000
# RUNJOBS_REQUEST_TIMEOUT_MS=120000
# RUNJOBS_LEASE_SECONDS=300

# ── Alertas de salud de la base (/api/worker/health, /api/health) ────────────
# Opcionales: los defaults están en src/lib/salud/base.ts. Ver docs/27.
# SALUD_DB_AVISO_MB=1024
# SALUD_DB_CRITICO_MB=2048
# SALUD_DB_CRECIMIENTO_PCT=10
# SALUD_PURGA_MAX_HORAS=36
# HEALTH_DB_SLOW_MS=3000

# ── Cifrado de secretos de report-utm ────────────────────────────────────────
# 64 caracteres hex = 32 bytes. Cambiarla deja ilegibles los tokens ya
# guardados en la base de datos.
#   openssl rand -hex 32
RUTM_ENCRYPTION_KEY=

# ── Administración / correo ──────────────────────────────────────────────────
ADMIN_EMAIL=
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=

# ── Meta (Facebook/Instagram Ads) ────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=

# ── TikTok Ads ───────────────────────────────────────────────────────────────
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# ── Google Sheets (service account) ──────────────────────────────────────────
# Solo la usa Sheets. GA4 no recurre a ella: usa la conexión OAuth de la agencia
# (abajo) o la service account propia de cada cliente en config_api.
# GOOGLE_SERVICE_ACCOUNT_KEY es la clave privada PEM COMPLETA, con los saltos
# de línea escapados como \n dentro de comillas dobles.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Google OAuth de agencia (GA4 + Sheets) ───────────────────────────────────
# App OAuth de la conexión única de la agencia (Ajustes → Conexión Google):
# lectura de GA4 (Data y Admin API) y de Sheets. Redirect URI:
# ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback. El `state` se firma con
# CRON_SECRET, que tiene que estar definido.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Google Ads ───────────────────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v21

# ── Hotmart ──────────────────────────────────────────────────────────────────
HOTMART_APP_CLIENT_ID=
HOTMART_APP_CLIENT_SECRET=

# ── WhatsApp ─────────────────────────────────────────────────────────────────
# `evolution` usa Evolution API; `gateway` usa el proceso whatsapp-gateway/.
WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_API_KEY=

# ── Opcionales ───────────────────────────────────────────────────────────────
# Activa el módulo report-utm en la interfaz.
# Presupuesto en ms para los sincronizadores de leads (por defecto ~50 s).
META_LEADS_BUDGET_MS=
GHL_LEADS_BUDGET_MS=
# Solo para el CLI de Supabase en local; el runtime no lo usa.
SUPABASE_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Agente conversacional
# ─────────────────────────────────────────────────────────────────────────────

# OpenRouter: sin esta clave el agente no puede responder (las herramientas y
# el servidor MCP siguen funcionando igual, porque no pasan por el modelo).
OPENROUTER_API_KEY=

# Así atribuye OpenRouter el tráfico a la aplicación en su panel. Opcionales.
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=

# Secreto compartido con el gateway de WhatsApp para firmar los mensajes
# entrantes (HMAC-SHA256). Debe ser el mismo valor en ambos lados. Sin él, la
# ruta de entrada responde 503 y el gateway no reenvía nada.
AGENT_INBOUND_SECRET=
