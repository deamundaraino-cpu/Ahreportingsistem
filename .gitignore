# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# debug/test scripts (root level)
/fix_*.js
/insert_test*.js
/meta_test*.js
/query*.js
/test_*.js
*_test.js

# env files (can opt-in for committing if needed)
.env*
# ...menos las plantillas: son la lista viva de variables que hay que
# configurar en el host, y `.env*` a secas también se las tragaba (el
# sync-worker/.env.example que cita la doc nunca llegó a versionarse).
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code internal
.claude/

# supabase cli temp files
supabase/.temp/

# Respaldos locales (CSV de tablas retiradas) - no versionar
/backups

# Volcados de estado previo que dejan los scripts de migración de datos.
# Son una red para revertir, no algo que deba viajar en el repo.
scripts/.backup-*.json
