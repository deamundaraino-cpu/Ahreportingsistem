# Puerto HTTP del gateway (Railway/Render lo inyectan vía $PORT)
PORT=8080

# Secreto compartido con la app Next.js (debe coincidir con WHATSAPP_GATEWAY_API_KEY en Vercel)
WHATSAPP_GATEWAY_API_KEY=cambia-esto-por-un-secreto-largo

# Supabase (service role: el gateway lee/escribe whatsapp_session)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Anti-baneo: ms mínimos entre envíos (default 1500)
WHATSAPP_SEND_THROTTLE_MS=1500

# Nivel de log de pino (debug | info | warn | error)
LOG_LEVEL=info

# Reenvío de mensajes entrantes a la aplicación. Si falta cualquiera de las
# dos, el gateway sigue funcionando solo de salida (como hasta ahora).
APP_URL=
AGENT_INBOUND_SECRET=
