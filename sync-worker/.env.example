# sync-worker — variables de entorno
# Copiar a .env (local) o configurar en el panel del host / docker-compose.

# Supabase (mismo proyecto que la app). El service role es necesario para
# reclamar jobs y escribir el historial.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# URL pública de la app en Vercel. El worker llama a sus endpoints de sync.
APP_URL=https://reportes.adshouse.cloud

# Debe coincidir EXACTAMENTE con el CRON_SECRET configurado en Vercel.
CRON_SECRET=

# Puerto del healthcheck (Railway/Render inyectan PORT automáticamente).
PORT=8080

# Zona horaria de la operación: define a qué hora local corren los planes.
TZ_OPERACION=America/Bogota

# Segundos entre pasadas a la cola. Bajarlo hace más reactivo el sync manual
# del dashboard; subirlo reduce consultas a Postgres cuando no hay trabajo.
POLL_SECONDS=15
